# Copy to .env (loaded automatically at startup).

# GraphQL feature gates (default true). Disable in production.
GRAPHQL_INTROSPECTION=true
GRAPHQL_PLAYGROUND=true

# Admin mutations (createMap/updateMap/deleteMap/validateMap) require the
# X-Admin-Key header to equal ADMIN_API_KEY.
ADMIN_API_KEY=
# Local development only: allow admin mutations with no key configured.
ALLOW_UNAUTHENTICATED_ADMIN=false

# Comma-separated websocket origins; empty or * allows all.
ALLOWED_ORIGINS=

# Max live sessions (default 1000).
MAX_SESSIONS=1000
# Idle session lifetime, Go duration (default 168h = 7d); swept on startup.
SESSION_TTL=168h
